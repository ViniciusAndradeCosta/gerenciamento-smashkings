# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# IA (chat do King e leitura de nota fiscal) — opcional e gratuito.
# Crie uma chave grátis no Google AI Studio: https://aistudio.google.com/app/apikey
# Sem esta chave, o chat funciona em "modo local" (responde as perguntas
# comuns direto do banco, sem IA externa).
GEMINI_API_KEY=sua-chave-gemini-aqui
# Opcional: modelo do Gemini (padrão gemini-flash-latest, que aponta pro flash atual)
# GEMINI_MODEL=gemini-flash-latest
